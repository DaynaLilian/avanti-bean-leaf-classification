      "source": [
        "Explicação: A classe Pipeline é usada para carregar, pré-processar e transformar imagens de um conjunto de dados. Quando solicitada, ela recupera uma imagem pelo caminho, aplica as transformações (como redimensionamento ou normalização), e retorna a imagem transformada junto com seu rótulo correspondente. Isso facilita o treinamento de redes neurais, pois o PyTorch pode usar essa classe para carregar as imagens de forma eficiente."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 77,
      "metadata": {
        "id": "K1lP2Mrxn4Ig"
      },
      "outputs": [],
      "source": [
        "class Pipeline(Dataset):\n",
        "    # Modificar __init__ para aceitar um DataFrame com caminhos de imagem e rótulos\n",
        "    def __init__(self, dataframe, class_to_idx, transform=None):\n",
        "        super(Pipeline, self).__init__()\n",
        "        self.dataframe = dataframe\n",
        "        self.transform = transform\n",
        "        self.class_to_idx = class_to_idx # Usar o mapeamento fornecido\n",
        "        self.classes = sorted(class_to_idx.keys(), key=lambda x: class_to_idx[x]) # Reconstruir lista de classes\n",
        "\n",
        "        # Preparar dados no formato (image_path, label_index)\n",
        "        self.data = []\n",
        "        for _, row in self.dataframe.iterrows():\n",
        "            img_path = row['path']\n",
        "            label_name = row['classe']\n",
        "            # Certificar de que o rótulo do dataframe é mapeado para o índice inteiro\n",
        "            label_idx = self.class_to_idx[label_name]\n",
        "            self.data.append((img_path, label_idx))\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.data)\n",
        "\n",
        "    def __getitem__(self, x):\n",
        "        img_path, label = self.data[x]\n",
        "\n",
        "        # Leitura com OpenCV\n",
        "        img = cv2.imread(img_path)\n",
        "        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "        if self.transform:\n",
        "            img = self.transform(img)\n",
        "\n",
        "        return img, label"
      ]
    },
